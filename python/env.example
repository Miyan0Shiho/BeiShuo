# 应用配置
DEBUG=False
HOST=0.0.0.0
PORT=8080

# 数据库服务配置
DATABASE_API_BASE_URL=http://localhost:8081/api/database
DATABASE_API_CONNECT_TIMEOUT=5000
DATABASE_API_READ_TIMEOUT=10000
DATABASE_API_RETRY_TIMES=3

# Redis服务配置
REDIS_API_BASE_URL=http://localhost:8082/api/redis
REDIS_API_CONNECT_TIMEOUT=3000
REDIS_API_READ_TIMEOUT=5000
REDIS_API_RETRY_TIMES=3

# LLM服务配置
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30000

# RAG服务配置
RAG_API_BASE_URL=http://localhost:8083/api/rag
RAG_API_CONNECT_TIMEOUT=5000
RAG_API_READ_TIMEOUT=15000
RAG_API_TOP_K=5

# JWT配置
JWT_SECRET=K8mN2pQ7vX4wZ9aB3cD5eF6gH1jL8nM0qR2sT4uV6wY8zA1bC3dE5fG7hI9jK0
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ALGORITHM=HS512

# 缓存配置
CACHE_INSCRIPTION_LIST_TTL=300
CACHE_KNOWLEDGE_LIST_TTL=600
CACHE_SEARCH_RESULT_TTL=600
CACHE_USER_INFO_TTL=1800

# 文件上传配置
FILE_UPLOAD_PATH=./uploads
FILE_UPLOAD_MAX_SIZE=10485760
FILE_UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp
FILE_UPLOAD_URL_PREFIX=/uploads

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/python-backend.log

